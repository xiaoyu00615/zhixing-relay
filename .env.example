# ---------------------------
# Local Relay
# ---------------------------
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# Optional but recommended.
# If set, enter the same value in the Chrome extension popup.
# Example: use a long random string.
RELAY_SHARED_SECRET=

# tagged = only forward GPT assistant messages containing:
# [ZHIXING_RELAY] + TYPE: TASK
# all = forward every completed GPT assistant message (NOT recommended)
GPT_FORWARD_MODE=tagged

# When you manually type in the pinned ChatGPT conversation,
# automatically pause the relay so your message always wins.
PAUSE_ON_MANUAL_USER_MESSAGE=true

# true = WorkBuddy result is automatically submitted to ChatGPT.
# false = it is only staged in the ChatGPT composer.
AUTO_SEND_TO_CHATGPT=true

# ---------------------------
# WorkBuddy Local Assistant
# ---------------------------
# api = WorkBuddy OpenAPI
# cdp = control local WorkBuddy desktop through Chrome DevTools Protocol
WORKBUDDY_MODE=api
WORKBUDDY_CDP_URL=

WORKBUDDY_BASE_URL=https://www.workbuddy.cn
WORKBUDDY_ACCESS_TOKEN=

# Optional token refresh.
# The relay can refresh after a 401 if all 3 are configured.
WORKBUDDY_REFRESH_TOKEN=
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=

WORKBUDDY_POLL_INTERVAL_MS=1500

# After at least one WorkBuddy assistant message arrives,
# wait for a quiet period before treating the reply as complete.
WORKBUDDY_QUIET_MS=3500

# Maximum time to wait for one WorkBuddy turn.
# Default 2 hours.
WORKBUDDY_MAX_WAIT_MS=7200000
