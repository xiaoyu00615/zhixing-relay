# ---------------------------
# Local Relay
# ---------------------------
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# Optional but strongly recommended.
# If set, enter the same value in the Chrome extension popup.
# Example: use a long random string.
#
# The same secret guards the runtime control channel (127.0.0.1 only).
# Leave it EMPTY and the control channel refuses every request (503), so a
# missing secret fails closed instead of exposing the relay to the network.
RELAY_SHARED_SECRET=

# The runtime control channel: the same commands the CLI offers
# (r / p / status / restart) reachable over loopback HTTP, because a relay
# supervised by pm2 has no console left to type them into.
# Only 127.0.0.1 is ever bound. Default 8788; use 0 to let the OS pick.
# Every request needs header: X-Relay-Secret
#   POST /control/status    state / paused / currentTask / pending / heartbeat
#   POST /control/resume    equivalent of `r`
#   POST /control/pause     equivalent of `p`
#   POST /control/restart   graceful stop of the current round
#   POST /control/heartbeat print one beat immediately
# RELAY_CONTROL_PORT=8788

# tagged = only forward GPT assistant messages containing:
# [ZHIXING_RELAY] + TYPE: TASK
# all = forward every completed GPT assistant message (NOT recommended)
GPT_FORWARD_MODE=tagged

# When you manually type in the pinned ChatGPT conversation,
# automatically pause the relay so your message always wins.
PAUSE_ON_MANUAL_USER_MESSAGE=true

# true = WorkBuddy result is automatically submitted to ChatGPT.
# false = it is only staged in the ChatGPT composer.
AUTO_SEND_TO_CHATGPT=true

# The RESULT is delivered as soon as it reaches ChatGPT: the task is then
# closed, so the next task is not queued behind a round that already answered.
# A RESULT that never reaches ChatGPT (or never gets acknowledged) is released
# after this lease, which frees the task record without ever re-sending the
# RESULT. Largest value = longest a stuck round can hold the relay.
# Default 120000.
# RESULT_LEASE_MS=120000

# How often one task goes back to the pending queue after a WorkBuddy failure
# or cancellation before Relay refuses it. Bounded so a task WorkBuddy always
# refuses cannot cycle for ever. Default 3.
# RELAY_MAX_TASK_RETRIES=3

# Liveness. Relay prints a [relay-heartbeat] block this often and complains
# in the log if a beat goes missing, which is how a wedged console window or a
# blocked event loop becomes visible. Default 30000.
# HEARTBEAT_MS=30000

# How long without a heartbeat before the watchdog writes a heartbeat_stale
# audit entry and logs an error. Must be larger than HEARTBEAT_MS. Default 60000.
# HEARTBEAT_STALE_MS=60000

# ---------------------------
# WorkBuddy Local Assistant
# ---------------------------
# api = WorkBuddy OpenAPI
# cdp = control local WorkBuddy desktop through Chrome DevTools Protocol
WORKBUDDY_MODE=api
WORKBUDDY_CDP_URL=

WORKBUDDY_BASE_URL=https://www.workbuddy.cn
WORKBUDDY_ACCESS_TOKEN=

# Optional token refresh.
# The relay can refresh after a 401 if all 3 are configured.
WORKBUDDY_REFRESH_TOKEN=
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=

WORKBUDDY_POLL_INTERVAL_MS=1500

# After at least one WorkBuddy assistant message arrives,
# wait for a quiet period before treating the reply as complete.
WORKBUDDY_QUIET_MS=3500

# Maximum time to wait for one WorkBuddy turn.
# Default 2 hours.
WORKBUDDY_MAX_WAIT_MS=7200000

# ---------------------------
# Model Router (routing + quota recovery)
# ---------------------------
# Leave these unset for the default catalog order, which is also the fallback
# order a task uses when its own MODEL: cannot run:
#
#   Hy4 preview -> Hy3 -> Deepseek-V4.1-Flash -> GLM-5.3-Flash
#
# Model ids (prefer ids over labels, labels are UI strings that can be renamed):
# hy4-preview | hy3 | deepseek-v4.1-flash | glm-5.3-flash

# Overrides that order. Comma-separated ids; unknown ids are ignored and the
# remaining catalog order is appended.
# MODEL_PRIORITY=hy4-preview,hy3,deepseek-v4.1-flash,glm-5.3-flash

# Forces models off permanently. Prefer letting the quota detector block a
# model at runtime - a manual switch hides the real "exhausted -> fallback"
# path that quota recovery depends on.
# MODEL_DISABLED=

# Per-model fallback chains used when the requested model cannot run.
# Grammar: "modelId:next,next|..." - a colon needs no escaping and a chain
# entry containing one is dropped. Unlisted models fall back along the order
# above.
# MODEL_FALLBACKS=hy4-preview:hy3|hy3:glm-5.3-flash

# A task names its model with a header in the TASK envelope:
#
#   [ZHIXING_RELAY]
#   TYPE: TASK
#   TASK_ID: xxx
#   MODEL: hy3
#
# Unknown id or label: WARNING only, routing continues by priority.

# How many times ONE task may be re-dispatched after WorkBuddy reports a model
# exhausted. Bounded on purpose. Default 2.
# MODEL_QUOTA_RETRIES=2

# How long to block a model whose reset time the notice did not give. This is
# only a fallback; the stored block is always an absolute instant.
# Default 3600000 (1 hour).
# MODEL_QUOTA_BLOCK_MS=3600000
